{
	# Traefik terminates TLS in front of this container, so Caddy must not try
	# to obtain certificates or bind :443.
	auto_https off
	# No admin socket and no config persistence: both need a writable path,
	# and the pod runs with readOnlyRootFilesystem: true.
	admin off
	persist_config off
	log {
		output stdout
		format json
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	# Probe target. Declared before the security headers so kubelet gets a
	# minimal response, and outside the file server so it works even if /srv
	# were empty.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		header {
			-Server
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
			Cross-Origin-Opener-Policy "same-origin"
		}

		# Hugo fingerprints assets under /assets, so they can be cached forever.
		@immutable path /assets/* /fonts/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# HTML and the search index change on every release and must be
		# revalidated, otherwise a new post stays invisible behind a cache.
		@revalidate path *.html / */ /index.json /index.xml /sitemap.xml /robots.txt
		header @revalidate Cache-Control "public, max-age=0, must-revalidate"

		try_files {path} {path}/ {path}.html
		file_server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}
}
