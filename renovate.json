{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Paris",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "description": "Hugo binary and the Hugo builder image must move together, or a local build and the container build diverge",
      "groupName": "hugo",
      "matchPackageNames": [
        "gohugoio/hugo",
        "hugomods/hugo"
      ]
    },
    {
      "description": "Caddy runtime image",
      "groupName": "caddy",
      "matchPackageNames": [
        "caddy"
      ]
    },
    {
      "description": "Blowfish is semver-tagged, so it needs no special scheduling; group it so the theme moves in one pull request",
      "groupName": "blowfish",
      "matchPackageNames": [
        "github.com/nunocoracao/blowfish/v2"
      ]
    },
    {
      "description": "GitHub Actions are pinned to a commit SHA; keep the readable tag comment in sync",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "pinDigests": true
    },
    {
      "description": "The blog's own artifacts are published by release.yml, never by Renovate",
      "matchPackageNames": [
        "ghcr.io/wihrt/blog",
        "ghcr.io/wihrt/charts/blog"
      ],
      "enabled": false
    },
    {
      "description": "Tool and dependency updates carry no production risk: a bad version fails CI, and CI gates the merge",
      "matchManagers": [
        "mise",
        "gomod",
        "github-actions",
        "dockerfile",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Major bumps change behaviour by definition; a green pipeline is not enough evidence",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "needs-review"
      ]
    }
  ]
}
